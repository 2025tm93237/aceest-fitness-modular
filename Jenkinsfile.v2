pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Setup Environment') {
      steps {
        sh '''
          python3 -m venv venv
          . venv/bin/activate
          pip install --upgrade pip
          pip install -r requirements.txt
        '''
      }
    }

    stage('Lint') {
      steps {
        sh '''
          . venv/bin/activate
          flake8 app tests
        '''
      }
    }

    stage('Unit Tests') {
      steps {
        sh '''
          . venv/bin/activate
          pytest -v --cov=app
        '''
      }
    }

    stage('SonarQube Scan & Quality Gate') {
      steps {
        withSonarQubeEnv('My SonarQube Server') {
          sh "${tool 'sonar-scanner'}/bin/sonar-scanner"
          sh '''
            CE_TASK_URL=$(grep ceTaskUrl .scannerwork/report-task.txt | cut -d'=' -f2-)
            STATUS="PENDING"
            for i in $(seq 1 20); do
              STATUS=$(curl -s -u "$SONAR_AUTH_TOKEN": "$CE_TASK_URL" | grep -o '"status":"[A-Z]*"' | head -1 | cut -d'"' -f4)
              echo "CE task status: $STATUS"
              if [ "$STATUS" = "SUCCESS" ] || [ "$STATUS" = "FAILED" ] || [ "$STATUS" = "CANCELED" ]; then break; fi
              sleep 3
            done
            if [ "$STATUS" != "SUCCESS" ]; then
              echo "SonarQube analysis task did not finish successfully: $STATUS"
              exit 1
            fi
            ANALYSIS_ID=$(curl -s -u "$SONAR_AUTH_TOKEN": "$CE_TASK_URL" | grep -o '"analysisId":"[^"]*"' | cut -d'"' -f4)
            GATE_STATUS=$(curl -s -u "$SONAR_AUTH_TOKEN": "$SONAR_HOST_URL/api/qualitygates/project_status?analysisId=$ANALYSIS_ID" | grep -o '"status":"[A-Z]*"' | head -1 | cut -d'"' -f4)
            echo "Quality Gate status: $GATE_STATUS"
            if [ "$GATE_STATUS" != "OK" ]; then
              echo "Quality Gate failed: $GATE_STATUS"
              exit 1
            fi
          '''
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Docker Build') {
      steps { sh 'docker build -t localhost:5050/aceest-fitness-modular:${BUILD_TAG} .' }
    }

    stage('Podman Build') {
      steps { sh 'sudo podman build -t localhost:5050/aceest-fitness-modular:${BUILD_TAG}-podman .' }
    }

    stage('Push Registry') {
      steps { sh 'docker push localhost:5050/aceest-fitness-modular:${BUILD_TAG}' }
    }

    stage('Deploy') {
      steps { sh 'kubectl apply -f k8s/base/' }
    }
  }
}
